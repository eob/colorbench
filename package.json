{
  "name": "colorbench",
  "version": "0.3.1",
  "description": "ColorBench: reproducible visual color matching and numeric color estimation pilot.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "render": "bun run src/render.ts",
    "test": "bun run test:python && bun run test:ts && bun run typecheck",
    "test:python": ".venv/bin/python -m pytest",
    "test:ts": "bun test src",
    "typecheck": "tsc --noEmit",
    "benchmark": ".venv/bin/python -m baseline.runner",
    "benchmark:mock": ".venv/bin/python -m baseline.runner --release 0.3.1 --mock --max-tasks 3",
    "export": ".venv/bin/python -m baseline.export_structured",
    "validate:release": ".venv/bin/python -m baseline.releases --release 0.3.1",
    "validate:candidate": ".venv/bin/python -m baseline.validate_dataset dataset/candidate-rendered/manifest.json",
    "build:branding": "bun run branding/render.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "typescript": "5.9.3",
    "playwright": "1.63.0"
  }
}
