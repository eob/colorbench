{
  "name": "colorbench",
  "version": "0.1.0",
  "description": "Visual semantic color, surface role, contrast tier, and gradient perception benchmark for multimodal vision-language models",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "render": "bun run src/render.ts",
    "test": "bun test",
    "pytest": ".venv/bin/pytest tests",
    "benchmark:mock": ".venv/bin/python baseline/runner.py --mock --models gemini-3.5-flash-lite --max-tasks 10",
    "export": ".venv/bin/python baseline/export_structured.py"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.50.0"
  }
}
